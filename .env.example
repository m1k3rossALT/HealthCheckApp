# ── Backend ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Optional API key. Leave blank to disable auth.
API_KEY=

# Must match the port the frontend is served on (browser-facing).
CORS_ORIGIN=http://localhost:5173

LOG_FORMAT=combined
LOG_LEVEL=info
CHECK_TIMEOUT_MS=5000
CHECK_CONCURRENCY=5

# ── Login credentials ─────────────────────────────────────────────
LOGIN_CREDENTIALS_ADMINPANEL_USERNAME=
LOGIN_CREDENTIALS_ADMINPANEL_PASSWORD=

LOGIN_CREDENTIALS_FINANCETOOL_USERNAME=
LOGIN_CREDENTIALS_FINANCETOOL_PASSWORD=

LOGIN_CREDENTIALS_DEVOPSPORTAL_USERNAME=
LOGIN_CREDENTIALS_DEVOPSPORTAL_PASSWORD=

LOGIN_CREDENTIALS_HRSYSTEM_USERNAME=
LOGIN_CREDENTIALS_HRSYSTEM_PASSWORD=

LOGIN_CREDENTIALS_CUSTOMERPORTAL_USERNAME=
LOGIN_CREDENTIALS_CUSTOMERPORTAL_PASSWORD=

# ── Frontend build arg ────────────────────────────────────────────
# URL the BROWSER uses to reach the backend.
# For local Docker: http://localhost:3000
# For production: https://api.yourdomain.com
VITE_API_URL=http://localhost:3000
