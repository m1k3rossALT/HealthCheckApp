# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Security ──────────────────────────────────────────────
# Optional. If set, all API requests must include:
#   x-api-key: <value>
API_KEY=

# Comma-separated allowed origins for CORS.
# Example: http://localhost:5173,https://yourapp.com
CORS_ORIGIN=http://localhost:5173

# ── Logging ───────────────────────────────────────────────
# 'dev' (human-readable) or 'combined' (structured, for prod)
LOG_FORMAT=dev
# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# ── Check behaviour ───────────────────────────────────────
# Default timeout per URL check in milliseconds
CHECK_TIMEOUT_MS=5000
# Max categories checked in parallel during check-all
CHECK_CONCURRENCY=5

# ── Login credentials ─────────────────────────────────────
# One pair per category. Key names must match env_username_key
# and env_password_key values in urls.json.

LOGIN_CREDENTIALS_ADMINPANEL_USERNAME=
LOGIN_CREDENTIALS_ADMINPANEL_PASSWORD=

LOGIN_CREDENTIALS_FINANCETOOL_USERNAME=
LOGIN_CREDENTIALS_FINANCETOOL_PASSWORD=

LOGIN_CREDENTIALS_DEVOPSPORTAL_USERNAME=
LOGIN_CREDENTIALS_DEVOPSPORTAL_PASSWORD=

LOGIN_CREDENTIALS_HRSYSTEM_USERNAME=
LOGIN_CREDENTIALS_HRSYSTEM_PASSWORD=

LOGIN_CREDENTIALS_CUSTOMERPORTAL_USERNAME=
LOGIN_CREDENTIALS_CUSTOMERPORTAL_PASSWORD=
